# ===================================
# Watchout Backend Environment Variables
# ===================================
# Copy this file to .env and fill in your values

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourCluster

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Mapbox
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# WeatherAPI
WEATHERAPI_KEY=your-weatherapi-key

# Tavily Search
TAVILY_API_KEY=your-tavily-api-key

# Multimodal Reel Integration
OPENAI_API_KEY=your-openai-api-key
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=instagram-scraper-api2.p.rapidapi.com

# Serper (fallback search)
SERPER_API_KEY=your-serper-api-key

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Application
APP_ENV=development
APP_SECRET_KEY=your-super-secret-key-change-in-production
FRONTEND_URL=http://localhost:3000
